{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Run directly by Node (type stripping + 01_tools/resolveTs.ts for shared's extensionless
    // imports): only erasable syntax, explicit .ts imports here, Node's own modules.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src"]
}
